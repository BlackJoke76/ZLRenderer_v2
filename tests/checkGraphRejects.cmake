cmake_minimum_required(VERSION 3.24)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ZL_VULKAN_TEST_CASE=graph-double "${testExecutable}"
    RESULT_VARIABLE result OUTPUT_VARIABLE validLog ERROR_VARIABLE errors TIMEOUT 20)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot capture actual double-group fixture: ${errors}")
endif()
file(MAKE_DIRECTORY "${logDirectory}")
set(validPath "${logDirectory}/primary-valid.log")
file(WRITE "${validPath}" "${validLog}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DgraphLogPath=${validPath}" -DexpectedGraphGroups=2
    -P "${CMAKE_CURRENT_LIST_DIR}/checkRenderGraph.cmake" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Actual valid primary evidence rejected")
endif()
foreach(damage wrong-count missing-primary duplicate-primary wrong-order missing-exit)
    set(damagedLog "${validLog}")
    if(damage STREQUAL wrong-count)
        string(REPLACE "Graph submit inputs count=2" "Graph submit inputs count=1" damagedLog "${damagedLog}")
    elseif(damage STREQUAL missing-primary)
        string(REGEX REPLACE "Graph primary end group=1 command=[0-9]+" "" damagedLog "${damagedLog}")
    elseif(damage STREQUAL duplicate-primary)
        string(REGEX MATCH "Graph submit command index=0 command=([0-9]+)" firstCommand "${damagedLog}")
        set(commandHandle "${CMAKE_MATCH_1}")
        string(REGEX REPLACE "Graph submit command index=1 command=[0-9]+" "Graph submit command index=1 command=${commandHandle}" damagedLog "${damagedLog}")
    elseif(damage STREQUAL wrong-order)
        string(REPLACE "Graph submit command index=0" "Graph submit command index=1" damagedLog "${damagedLog}")
    else()
        string(REGEX REPLACE "Graph barrier group=1 boundary=after[^\n]+" "" damagedLog "${damagedLog}")
    endif()
    set(damagedPath "${logDirectory}/${damage}.log")
    file(WRITE "${damagedPath}" "${damagedLog}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DgraphLogPath=${damagedPath}" -DexpectedGraphGroups=2
        -P "${CMAKE_CURRENT_LIST_DIR}/checkRenderGraph.cmake" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(result EQUAL 0)
        message(FATAL_ERROR "Damaged actual input accepted: ${damage}")
    endif()
endforeach()
