cmake_minimum_required(VERSION 3.24)
if(DEFINED graphLogPath)
    file(READ "${graphLogPath}" standardOutput)
endif()
if(NOT standardOutput MATCHES "Recording live workers=0")
    message(FATAL_ERROR "Workers were not joined before cleanup")
endif()
if(NOT control STREQUAL "startup")
    if(workerCount GREATER groupCount)
        set(actualWorkers ${groupCount})
    else()
        set(actualWorkers ${workerCount})
    endif()
    if(NOT standardOutput MATCHES "Recording workers requested=${workerCount} actual=${actualWorkers}")
        message(FATAL_ERROR "Worker configuration mismatch")
    endif()
endif()
if(recordingFailure)
    if(control STREQUAL "startup" OR testCase MATCHES "^worker-(pool|primary)")
        set(expectedFrames 0)
    else()
        set(expectedFrames 3)
    endif()
    if(NOT standardOutput MATCHES "Frame summary: submitted=${expectedFrames} presented=${expectedFrames}")
        message(FATAL_ERROR "Failure advanced the frame")
    endif()
    string(REGEX MATCHALL "Resetting submission fence" fenceResets "${standardOutput}")
    list(LENGTH fenceResets resetCount)
    if(testCase STREQUAL "submit-later")
        math(EXPR expectedResets "${expectedFrames}+1")
    else()
        set(expectedResets ${expectedFrames})
    endif()
    if(NOT resetCount EQUAL expectedResets)
        message(FATAL_ERROR "Reset fence before batch success")
    endif()
    if(control MATCHES "^(sibling|nonstandard|multiple|group-begin|group-body|group-end|gate-timeout)$" AND
        NOT standardOutput MATCHES "Recording batch drained active=0")
        message(FATAL_ERROR "Failed batch did not drain")
    endif()
    if(control STREQUAL "nonstandard" AND NOT standardError MATCHES "non-standard exception")
        message(FATAL_ERROR "Lost nonstandard failure")
    endif()
    if(control MATCHES "^group-(begin|body|end)$" AND NOT standardOutput MATCHES "Recording batch drained active=0 [^\r\n]+order=0,")
        message(FATAL_ERROR "Later group failed before the earlier primary completed")
    endif()
    if(control STREQUAL "multiple" AND (NOT standardError MATCHES "record group=0" OR NOT standardError MATCHES "record group=1"))
        message(FATAL_ERROR "Lost multiple failures")
    endif()
elseif(control STREQUAL "overlap")
    if(NOT standardOutput MATCHES "Recording batch drained active=0 maximum=([2-9][0-9]*) timeout=0")
        message(FATAL_ERROR "Actual recording scopes did not overlap")
    endif()
    string(REGEX MATCHALL "Recording event [^\r\n]+" events "${standardOutput}")
    set(activeGroups)
    set(eventCount 0)
    set(observedMaximum 0)
    foreach(event IN LISTS events)
        if(NOT event MATCHES "sequence=([0-9]+) group=([0-9]+) action=(enter|exit) active=([0-9]+)")
            message(FATAL_ERROR "Malformed recording event")
        endif()
        set(sequence "${CMAKE_MATCH_1}")
        set(eventGroup "${CMAKE_MATCH_2}")
        set(action "${CMAKE_MATCH_3}")
        set(eventActive "${CMAKE_MATCH_4}")
        if(NOT sequence EQUAL eventCount)
            message(FATAL_ERROR "Recording event order lost")
        endif()
        math(EXPR eventCount "${eventCount}+1")
        if(action STREQUAL "enter")
            if(eventGroup IN_LIST activeGroups)
                message(FATAL_ERROR "Duplicate recording entry")
            endif()
            list(APPEND activeGroups "${eventGroup}")
        else()
            if(NOT eventGroup IN_LIST activeGroups)
                message(FATAL_ERROR "Recording exit without entry")
            endif()
            list(REMOVE_ITEM activeGroups "${eventGroup}")
        endif()
        list(LENGTH activeGroups observedActive)
        if(NOT observedActive EQUAL eventActive)
            message(FATAL_ERROR "Recording event active count is inconsistent")
        endif()
        if(observedActive GREATER observedMaximum)
            set(observedMaximum ${observedActive})
        endif()
    endforeach()
    math(EXPR expectedEventCount "${groupCount}*2")
    if(activeGroups OR NOT eventCount EQUAL expectedEventCount OR observedMaximum LESS 2)
        message(FATAL_ERROR "Actual recording intervals do not overlap")
    endif()
    string(REGEX MATCH "Graph submitted frame=4 [^~]*Graph record end" controlledFrame "${standardOutput}")
    string(REGEX MATCH "Graph worker group=0 worker=([0-9]+) thread=([^ ]+) pool=([0-9]+) command=([0-9]+)" firstWorker "${controlledFrame}")
    set(firstWorkerIndex "${CMAKE_MATCH_1}")
    set(firstThread "${CMAKE_MATCH_2}")
    set(firstPool "${CMAKE_MATCH_3}")
    string(REGEX MATCH "Graph worker group=1 worker=([0-9]+) thread=([^ ]+) pool=([0-9]+) command=([0-9]+)" secondWorker "${controlledFrame}")
    if(NOT firstWorker OR NOT secondWorker OR firstWorkerIndex STREQUAL CMAKE_MATCH_1 OR firstThread STREQUAL CMAKE_MATCH_2 OR firstPool STREQUAL CMAKE_MATCH_3)
        message(FATAL_ERROR "Overlap did not use different actual workers/threads/pools")
    endif()
elseif(control STREQUAL "reverse")
    if(NOT standardOutput MATCHES "order=1,0,")
        message(FATAL_ERROR "Did not reverse actual recording completion")
    endif()
endif()
if(NOT recordingFailure)
    math(EXPR laneCount "${actualWorkers}")
    if(laneCount EQUAL 0)
        set(laneCount 1)
    endif()
    math(EXPR expectedPoolCount "2*${laneCount}")
    math(EXPR expectedPrimaryCount "${expectedPoolCount}*${groupCount}")
    string(REGEX MATCHALL "Command resource slot=[^\r\n]+" resources "${standardOutput}")
    list(LENGTH resources primaryCount)
    string(REGEX MATCHALL "Created command pool[\r\n]" pools "${standardOutput}")
    list(LENGTH pools poolCount)
    if(NOT primaryCount EQUAL expectedPrimaryCount OR NOT poolCount EQUAL expectedPoolCount)
        message(FATAL_ERROR "Unexpected command object allocation or churn")
    endif()
    set(commandIdentities)
    foreach(resource IN LISTS resources)
        if(NOT resource MATCHES "slot=([01]) worker=([0-9]+) group=([0-9]+) pool=([0-9]+) command=([0-9]+)")
            message(FATAL_ERROR "Invalid allocated primary identity")
        endif()
        if(CMAKE_MATCH_5 IN_LIST commandIdentities OR CMAKE_MATCH_5 STREQUAL "0")
            message(FATAL_ERROR "Duplicate allocated primary")
        endif()
        list(APPEND commandIdentities "${CMAKE_MATCH_5}")
    endforeach()
endif()
message(STATUS "PASS recording workers=${workerCount} groups=${groupCount} control=${control}")
