cmake_minimum_required(VERSION 3.24)
foreach(groupCount 1 2 5)
    unset(baseline)
    foreach(workerCount 0 1 4)
        file(READ "${logDirectory}/recording-${workerCount}-${groupCount}/normal.stdout.log" captured)
        string(REGEX MATCH "Graph submitted frame=1 [^~]+" firstFrame "${captured}")
        string(FIND "${firstFrame}" "Graph record end" recordEnd)
        if(recordEnd LESS 0)
            message(FATAL_ERROR "Missing complete frame in mode comparison")
        endif()
        string(SUBSTRING "${firstFrame}" 0 ${recordEnd} firstFrame)
        string(REGEX MATCHALL "Graph (barrier|group|submit inputs) [^\r\n]+" semanticInputs "${firstFrame}")
        string(REGEX REPLACE "(imageHandle|framebuffer|renderPass)=[0-9]+" "\\1=bound" semanticInputs "${semanticInputs}")
        if(NOT DEFINED baseline)
            set(baseline "${semanticInputs}")
        elseif(NOT semanticInputs STREQUAL baseline)
            message(FATAL_ERROR "Serial/parallel semantic inputs differ for ${groupCount} groups/${workerCount} workers")
        endif()
    endforeach()
endforeach()
message(STATUS "PASS serial/single/multi-worker actual barrier, attachment and submit semantics")
