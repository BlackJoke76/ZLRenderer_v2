cmake_minimum_required(VERSION 3.24)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ZL_VULKAN_TEST_CASE=normal
    ZL_RECORDING_WORKERS=4 ZL_RECORDING_GROUPS=2 ZL_RECORDING_TEST_CASE=overlap "${testExecutable}"
    RESULT_VARIABLE result OUTPUT_VARIABLE validLog ERROR_VARIABLE errors TIMEOUT 20)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot capture overlap fixture: ${errors}")
endif()
file(MAKE_DIRECTORY "${logDirectory}")
foreach(damage valid fake-overlap missing-event same-worker same-thread same-pool missing-worker duplicate-primary)
    set(damagedLog "${validLog}")
    string(REGEX MATCH "Graph submitted frame=4 [^~]*Graph record end" controlledFrame "${validLog}")
    string(REGEX MATCH "Graph worker group=0 worker=([0-9]+) thread=([^ ]+) pool=([0-9]+) command=([0-9]+)" first "${controlledFrame}")
    set(firstIndex "${CMAKE_MATCH_1}")
    set(firstThread "${CMAKE_MATCH_2}")
    set(firstPool "${CMAKE_MATCH_3}")
    if(damage STREQUAL fake-overlap)
        string(REGEX REPLACE "maximum=[0-9]+" "maximum=1" damagedLog "${damagedLog}")
    elseif(damage STREQUAL missing-event)
        string(REGEX REPLACE "Recording event sequence=1[^\n]+" "" damagedLog "${damagedLog}")
    elseif(damage STREQUAL same-worker)
        string(REGEX REPLACE "Graph worker group=1 worker=[0-9]+" "Graph worker group=1 worker=${firstIndex}" damagedLog "${damagedLog}")
    elseif(damage STREQUAL same-thread)
        string(REGEX REPLACE "(Graph worker group=1 worker=[0-9]+ thread=)[^ ]+" "\\1${firstThread}" damagedLog "${damagedLog}")
    elseif(damage STREQUAL same-pool)
        string(REGEX REPLACE "(Graph worker group=1 worker=[0-9]+ thread=[^ ]+ pool=)[0-9]+" "\\1${firstPool}" damagedLog "${damagedLog}")
    elseif(damage STREQUAL missing-worker)
        string(REGEX REPLACE "Graph worker group=1[^\n]+" "" damagedLog "${damagedLog}")
    elseif(damage STREQUAL duplicate-primary)
        string(REGEX REPLACE "(Command resource [^\n]+ command=)[0-9]+" "\\11234" damagedLog "${damagedLog}")
    endif()
    set(logPath "${logDirectory}/${damage}.log")
    file(WRITE "${logPath}" "${damagedLog}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DgraphLogPath=${logPath}"
        -Dcontrol=overlap -DworkerCount=4 -DgroupCount=2 -DtestCase=normal -DrecordingFailure=FALSE
        -P "${CMAKE_CURRENT_LIST_DIR}/checkParallelEvidence.cmake"
        RESULT_VARIABLE checkResult OUTPUT_QUIET ERROR_VARIABLE checkError)
    if(damage STREQUAL valid)
        if(NOT checkResult EQUAL 0)
            message(FATAL_ERROR "Valid overlap evidence rejected: ${checkError}")
        endif()
    elseif(checkResult EQUAL 0)
        message(FATAL_ERROR "Damaged overlap evidence accepted: ${damage}")
    endif()
endforeach()
