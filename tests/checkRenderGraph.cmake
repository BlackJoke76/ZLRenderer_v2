cmake_minimum_required(VERSION 3.24)
# Shared by CTest and verifyWindow.ps1; inspect captured actual API inputs, not a fixed summary.
if(DEFINED graphLogPath)
    file(READ "${graphLogPath}" standardOutput)
endif()
set(graphPlanKeys)
set(graphSubmittedKeys)
set(graphRecordOpen FALSE)
set(graphRecordCount 0)
string(REPLACE "\n" ";" graphLines "${standardOutput}")
foreach(graphLine IN LISTS graphLines)
    string(STRIP "${graphLine}" graphLine)
    if(graphLine MATCHES "^Graph attachment .*load=([01]) store=([01]) initialLayout=2 finalLayout=2 dependencies=0$")
        # These are actual vkCreateRenderPass inputs. Any other Graph attachment line fails below.
    elseif(graphLine MATCHES "^Graph attachment ")
        message(FATAL_ERROR "Render pass duplicates graph transitions: ${graphLine}")
    elseif(graphLine MATCHES "^Graph plan generation=([0-9]+) version=([0-9]+) slot=[01] image=[0-9]+ groups=([0-9]+)$")
        set(graphKey "${CMAKE_MATCH_1}:${CMAKE_MATCH_2}")
        if(graphKey IN_LIST graphPlanKeys OR NOT CMAKE_MATCH_3 EQUAL expectedGraphGroups)
            message(FATAL_ERROR "Duplicate/mismatched graph dump: ${graphLine}")
        endif()
        list(APPEND graphPlanKeys "${graphKey}")
    elseif(graphLine MATCHES "^Graph submitted frame=([0-9]+) generation=([0-9]+) version=([0-9]+) slot=[01] image=([0-9]+) groups=([0-9]+) submits=1 waitStage=1024$")
        if(graphRecordOpen OR NOT CMAKE_MATCH_5 EQUAL expectedGraphGroups)
            message(FATAL_ERROR "Invalid graph submission: ${graphLine}")
        endif()
        set(graphRecordOpen TRUE)
        set(graphFrame "${CMAKE_MATCH_1}")
        set(graphGeneration "${CMAKE_MATCH_2}")
        set(graphImageIndex "${CMAKE_MATCH_4}")
        set(graphKey "${CMAKE_MATCH_2}:${CMAKE_MATCH_3}")
        if(NOT graphKey IN_LIST graphPlanKeys)
            message(FATAL_ERROR "Submitted graph lacks its plan")
        endif()
        if(NOT graphKey IN_LIST graphSubmittedKeys)
            list(APPEND graphSubmittedKeys "${graphKey}")
        endif()
        set(graphOrder)
        set(graphImageIdentity "")
        set(graphFramebuffer "")
        set(graphRenderPass "")
    elseif(graphLine MATCHES "^Graph barrier group=([0-9]+) boundary=(before|after) resource=0 imageHandle=([0-9]+) oldLayout=([0-9]+) newLayout=([0-9]+) srcStage=([0-9]+) dstStage=([0-9]+) srcAccess=([0-9]+) dstAccess=([0-9]+) reasons=.+$")
        if(NOT graphRecordOpen)
            message(FATAL_ERROR "Barrier record has no successful submission")
        endif()
        set(groupIndex "${CMAKE_MATCH_1}")
        set(boundary "${CMAKE_MATCH_2}")
        set(imageIdentity "${CMAKE_MATCH_3}")
        set(oldLayout "${CMAKE_MATCH_4}")
        set(newLayout "${CMAKE_MATCH_5}")
        set(sourceStage "${CMAKE_MATCH_6}")
        set(destinationStage "${CMAKE_MATCH_7}")
        set(sourceAccess "${CMAKE_MATCH_8}")
        set(destinationAccess "${CMAKE_MATCH_9}")
        string(REGEX REPLACE ".* reasons=" "" reasons "${graphLine}")
        if(NOT graphImageIdentity STREQUAL "" AND NOT imageIdentity STREQUAL graphImageIdentity)
            message(FATAL_ERROR "A graph frame changed physical image")
        endif()
        set(graphImageIdentity "${imageIdentity}")
        if(boundary STREQUAL "before")
            if(groupIndex EQUAL 0)
                if(NOT oldLayout EQUAL 0 OR NOT sourceAccess EQUAL 0 OR NOT reasons MATCHES "external")
                    message(FATAL_ERROR "Invalid acquire barrier: ${graphLine}")
                endif()
            else()
                if(groupIndex GREATER_EQUAL expectedGraphGroups OR NOT oldLayout EQUAL 2 OR NOT sourceAccess EQUAL 256 OR NOT reasons MATCHES "WAW")
                    message(FATAL_ERROR "Missing real WAW: ${graphLine}")
                endif()
            endif()
            if(NOT newLayout EQUAL 2 OR NOT sourceStage EQUAL 1024 OR NOT destinationStage EQUAL 1024 OR NOT destinationAccess EQUAL 256)
                message(FATAL_ERROR "Wrong graph write synchronization: ${graphLine}")
            endif()
        else()
            math(EXPR lastGroup "${expectedGraphGroups}-1")
            if(NOT groupIndex EQUAL lastGroup OR NOT oldLayout EQUAL 2 OR NOT newLayout EQUAL 1000001002 OR
               NOT sourceStage EQUAL 1024 OR NOT destinationStage EQUAL 8192 OR NOT sourceAccess EQUAL 256 OR NOT destinationAccess EQUAL 0)
                message(FATAL_ERROR "Wrong final presentation transition: ${graphLine}")
            endif()
        endif()
        list(APPEND graphOrder "${boundary}-${groupIndex}")
    elseif(graphLine MATCHES "^Graph group group=([0-9]+) pass=([^ ]+) resource=0 imageHandle=([0-9]+) framebuffer=([0-9]+) renderPass=([0-9]+) extent=[0-9]+x[0-9]+ load=1 store=0 initialLayout=2 finalLayout=2 clearColor=")
        set(groupIndex "${CMAKE_MATCH_1}")
        set(passName "${CMAKE_MATCH_2}")
        set(imageIdentity "${CMAKE_MATCH_3}")
        set(framebuffer "${CMAKE_MATCH_4}")
        set(renderPass "${CMAKE_MATCH_5}")
        if(NOT graphRecordOpen OR NOT imageIdentity STREQUAL graphImageIdentity OR
           (NOT graphFramebuffer STREQUAL "" AND NOT framebuffer STREQUAL graphFramebuffer) OR
           (NOT graphRenderPass STREQUAL "" AND NOT renderPass STREQUAL graphRenderPass))
            message(FATAL_ERROR "Graph group lost its physical binding: ${graphLine}")
        endif()
        set(graphFramebuffer "${framebuffer}")
        set(graphRenderPass "${renderPass}")
        list(APPEND graphOrder "group-${groupIndex}")
    elseif(graphLine STREQUAL "Graph record end")
        set(expectedOrder)
        math(EXPR finalGroup "${expectedGraphGroups}-1")
        foreach(groupIndex RANGE 0 ${finalGroup})
            list(APPEND expectedOrder "before-${groupIndex}" "group-${groupIndex}")
        endforeach()
        list(APPEND expectedOrder "after-${finalGroup}")
        if(NOT graphRecordOpen OR NOT graphOrder STREQUAL expectedOrder)
            message(FATAL_ERROR "Graph/API order mismatch: ${graphOrder}")
        endif()
        set(graphRecordOpen FALSE)
        math(EXPR graphRecordCount "${graphRecordCount}+1")
    elseif(graphLine MATCHES "^Graph present request frame=([0-9]+) generation=([0-9]+) image=([0-9]+) result=(-?[0-9]+)$")
        if(NOT CMAKE_MATCH_1 STREQUAL graphFrame OR NOT CMAKE_MATCH_2 STREQUAL graphGeneration OR NOT CMAKE_MATCH_3 STREQUAL graphImageIndex)
            message(FATAL_ERROR "Present request differs from graph binding")
        endif()
    elseif(graphLine MATCHES "^Graph (barrier|group|submitted|plan) ")
        message(FATAL_ERROR "Malformed actual graph input record: ${graphLine}")
    endif()
endforeach()
if(graphRecordOpen OR NOT "${graphPlanKeys}" STREQUAL "${graphSubmittedKeys}")
    message(FATAL_ERROR "Incomplete or unsubmitted graph plan records")
endif()
if(standardOutput MATCHES "Frame summary: submitted=([0-9]+)" AND CMAKE_MATCH_1 GREATER 0 AND graphRecordCount EQUAL 0)
    message(FATAL_ERROR "Submitted frames bypassed graph execution records")
endif()
if(graphRecordCount GREATER 0 AND NOT standardOutput MATCHES "Graph resource index=0 name=swapchainColor ownership=external initialUse=undefined contentsDefined=0")
    message(FATAL_ERROR "External resource declaration is missing from graph diagnostics")
endif()
message(STATUS "PASS graph log: ${graphRecordCount} bounded frames; group/barrier/binding inputs agree")

# Verify primary scopes and the actual submit array independently of image mapping.
set(primaryOpen FALSE)
set(submitInputsSeen FALSE)
foreach(graphLine IN LISTS graphLines)
    string(STRIP "${graphLine}" graphLine)
    if(graphLine MATCHES "^Graph submitted .* slot=([01]) ")
        set(primarySlot "${CMAKE_MATCH_1}")
        set(recordedPrimaries)
        set(submittedPrimaries)
        set(submitInputsSeen FALSE)
        set(primaryOpen FALSE)
        set(workerGroups)
    elseif(graphLine MATCHES "^Graph worker group=([0-9]+) worker=([0-9]+) thread=([^ ]+) pool=([0-9]+) command=([0-9]+)$")
        set(workerGroup "${CMAKE_MATCH_1}")
        set(workerIndex "${CMAKE_MATCH_2}")
        set(workerThread "${CMAKE_MATCH_3}")
        set(workerPool "${CMAKE_MATCH_4}")
        set(workerCommand "${CMAKE_MATCH_5}")
        if(workerGroup IN_LIST workerGroups OR workerPool STREQUAL "0" OR workerCommand STREQUAL "0")
            message(FATAL_ERROR "Missing or duplicate worker identity")
        endif()
        list(APPEND workerGroups "${workerGroup}")
        set(laneKey "lane_${primarySlot}_${workerIndex}")
        set(commandKey "${laneKey}_${workerGroup}")
        if((DEFINED ${laneKey} AND NOT "${${laneKey}}" STREQUAL workerPool) OR
           (DEFINED ${commandKey} AND NOT "${${commandKey}}" STREQUAL workerCommand))
            message(FATAL_ERROR "Worker command resources were not reused")
        endif()
        set(${laneKey} "${workerPool}")
        set(${commandKey} "${workerCommand}")
    elseif(graphLine MATCHES "^Graph primary begin group=([0-9]+) command=([0-9]+)$")
        list(LENGTH recordedPrimaries nextGroup)
        if(primaryOpen OR NOT CMAKE_MATCH_1 EQUAL nextGroup OR CMAKE_MATCH_2 IN_LIST recordedPrimaries OR
           NOT CMAKE_MATCH_1 STREQUAL workerGroup OR NOT CMAKE_MATCH_2 STREQUAL workerCommand)
            message(FATAL_ERROR "Invalid primary begin: ${graphLine}")
        endif()
        set(primaryGroup "${CMAKE_MATCH_1}")
        set(primaryCommand "${CMAKE_MATCH_2}")
        set(primaryOpen TRUE)
    elseif(graphLine MATCHES "^Graph (barrier|group) group=([0-9]+) ")
        if(NOT primaryOpen OR NOT CMAKE_MATCH_2 EQUAL primaryGroup)
            message(FATAL_ERROR "Work outside its complete primary: ${graphLine}")
        endif()
    elseif(graphLine MATCHES "^Graph primary end group=([0-9]+) command=([0-9]+)$")
        if(NOT primaryOpen OR NOT CMAKE_MATCH_1 EQUAL primaryGroup OR NOT CMAKE_MATCH_2 STREQUAL primaryCommand)
            message(FATAL_ERROR "Invalid primary end: ${graphLine}")
        endif()
        list(APPEND recordedPrimaries "${primaryCommand}")
        set(primaryOpen FALSE)
    elseif(graphLine MATCHES "^Graph submit inputs count=([0-9]+) waits=1 signals=1$")
        list(LENGTH recordedPrimaries recordedCount)
        if(primaryOpen OR submitInputsSeen OR NOT CMAKE_MATCH_1 EQUAL recordedCount OR NOT recordedCount EQUAL expectedGraphGroups)
            message(FATAL_ERROR "Invalid actual submit count")
        endif()
        set(submitInputsSeen TRUE)
    elseif(graphLine MATCHES "^Graph submit command index=([0-9]+) command=([0-9]+)$")
        list(LENGTH submittedPrimaries nextCommand)
        if(NOT submitInputsSeen OR NOT CMAKE_MATCH_1 EQUAL nextCommand)
            message(FATAL_ERROR "Invalid submit array position")
        endif()
        list(APPEND submittedPrimaries "${CMAKE_MATCH_2}")
    elseif(graphLine STREQUAL "Graph record end")
        if(primaryOpen OR NOT submitInputsSeen OR NOT "${recordedPrimaries}" STREQUAL "${submittedPrimaries}")
            message(FATAL_ERROR "Submit array differs from complete recorded groups")
        endif()
        list(LENGTH workerGroups workerGroupCount)
        if(NOT workerGroupCount EQUAL recordedCount)
            message(FATAL_ERROR "Incomplete worker identities")
        endif()
    elseif(graphLine MATCHES "^Graph (primary|submit) ")
        message(FATAL_ERROR "Malformed primary or submit input: ${graphLine}")
    endif()
endforeach()
