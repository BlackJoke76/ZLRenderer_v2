# Inspect individual lines; preserve the full log and reject every unknown application message.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/knownEnvironmentDiagnostics.txt" knownEnvironmentPatterns)
string(REPLACE "\r" "" diagnosticLines "${standardError}")
string(REPLACE ";" "\\;" diagnosticLines "${diagnosticLines}")
string(REPLACE "\n" ";" diagnosticLines "${diagnosticLines}")
foreach(diagnosticLine IN LISTS diagnosticLines)
    if(NOT diagnosticLine MATCHES "\\[Vulkan (WARNING|ERROR)\\]")
        continue()
    endif()
    if(testCase STREQUAL "diagnostic" AND diagnosticLine STREQUAL
       "[Vulkan WARNING] [ZLRenderer-ControlledDiagnostic] Controlled callback delivery test; no invalid Vulkan operation.")
        continue()
    endif()
    set(knownEnvironmentMessage FALSE)
    foreach(environmentPattern IN LISTS knownEnvironmentPatterns)
        if(diagnosticLine MATCHES "^${environmentPattern}$")
            set(knownEnvironmentMessage TRUE)
            message(STATUS "Known environment diagnostic preserved: ${diagnosticLine}")
            break()
        endif()
    endforeach()
    if(NOT knownEnvironmentMessage)
        message(FATAL_ERROR "Unexpected Vulkan diagnostic: ${diagnosticLine}")
    endif()
endforeach()
