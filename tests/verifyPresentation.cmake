cmake_minimum_required(VERSION 3.24)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "ZL_VULKAN_TEST_CASE=${testCase}"
    "VK_LAYER_VALIDATE_SYNC=1" "${testExecutable}"
    RESULT_VARIABLE exitCode OUTPUT_VARIABLE standardOutput ERROR_VARIABLE standardError TIMEOUT 20)
file(MAKE_DIRECTORY "${logDirectory}")
file(WRITE "${logDirectory}/${testCase}.stdout.log" "${standardOutput}")
file(WRITE "${logDirectory}/${testCase}.stderr.log" "${standardError}")
set(successCases normal fifo alternate fence-timeout acquire-timeout acquire-out-of-date acquire-suboptimal present-out-of-date present-suboptimal)
if(testCase IN_LIST successCases)
    if(NOT exitCode STREQUAL "0" OR NOT standardOutput MATCHES "Frame summary: submitted=12 presented=[0-9]+")
        message(FATAL_ERROR "Frame progress failed: exit=${exitCode}\n${standardOutput}\n${standardError}")
    endif()
    if(NOT standardOutput MATCHES "Frame submitted slot=0" OR NOT standardOutput MATCHES "Frame submitted slot=1")
        message(FATAL_ERROR "Both frame slots must execute")
    endif()
    if(testCase MATCHES "out-of-date|suboptimal" AND NOT standardOutput MATCHES "Swapchain generation=2")
        message(FATAL_ERROR "Expected reconstruction did not occur")
    endif()
    if(testCase STREQUAL "fifo" AND NOT standardOutput MATCHES "mode=FIFO")
        message(FATAL_ERROR "FIFO runtime did not use FIFO")
    endif()
    if(testCase STREQUAL "alternate" AND NOT standardOutput MATCHES "clearColor=\\(0.200,0.050,0.100,1.000\\)")
        message(FATAL_ERROR "Alternate color not applied")
    endif()
    if(testCase MATCHES "timeout" AND NOT standardOutput MATCHES "Frame skipped:")
        message(FATAL_ERROR "Timeout control path not reached")
    endif()
    string(REGEX MATCHALL "Frame submitted slot=[^\r\n]+" frameRecords "${standardOutput}")
    foreach(frameRecord IN LISTS frameRecords)
        if(NOT frameRecord MATCHES "slot=([0-9]+) image=([0-9]+) command=([0-9A-Fa-f]+) acquire=([0-9A-Fa-f]+) present=([0-9A-Fa-f]+) fence=([0-9A-Fa-f]+) generation=([0-9]+)")
            message(FATAL_ERROR "Cannot parse resource identity: ${frameRecord}")
        endif()
        set(slotKey "slot_${CMAKE_MATCH_1}")
        set(imageKey "image_${CMAKE_MATCH_7}_${CMAKE_MATCH_2}")
        set(slotIdentity "${CMAKE_MATCH_3};${CMAKE_MATCH_4};${CMAKE_MATCH_6}")
        set(presentIdentity "${CMAKE_MATCH_5}")
        if(DEFINED ${slotKey} AND NOT "${${slotKey}}" STREQUAL "${slotIdentity}")
            message(FATAL_ERROR "Frame slot allocated new command/sync objects")
        endif()
        if(DEFINED ${imageKey} AND NOT "${${imageKey}}" STREQUAL "${presentIdentity}")
            message(FATAL_ERROR "Present semaphore must follow image identity")
        endif()
        set(${slotKey} "${slotIdentity}")
        set(${imageKey} "${presentIdentity}")
    endforeach()
else()
    if(NOT exitCode STREQUAL "1" OR NOT standardError MATCHES "Renderer failed:")
        message(FATAL_ERROR "Expected error exit: exit=${exitCode}\n${standardOutput}\n${standardError}")
    endif()
    if(testCase MATCHES "^(record|submit)$" AND NOT standardOutput MATCHES "Frame summary: submitted=0 presented=0")
        message(FATAL_ERROR "An aborted frame was counted as submitted")
    endif()
    if(testCase STREQUAL "submit" AND NOT standardError MATCHES "submit: vkQueueSubmit failed")
        message(FATAL_ERROR "Actual submit failure control path missing")
    endif()
    if(testCase STREQUAL "wait-failure" AND NOT standardError MATCHES "shutdown: vkDeviceWaitIdle failed")
        message(FATAL_ERROR "Wait failure was reported as normal close")
    endif()
endif()
# Every owned handle emits exactly one creation/release. Raw images and queues have no destruction.
foreach(resource "command pool" "acquire semaphore" "submission fence" "swapchain" "render pass" "image view" "framebuffer" "present semaphore")
    string(REGEX MATCHALL "Created ${resource}[\r\n]" creationEvents "${standardOutput}")
    string(REGEX MATCHALL "Released ${resource}[\r\n]" releaseEvents "${standardOutput}")
    list(LENGTH creationEvents creationCount)
    list(LENGTH releaseEvents releaseCount)
    if(NOT creationCount EQUAL releaseCount)
        message(FATAL_ERROR "Lifetime mismatch ${resource}: created=${creationCount} released=${releaseCount}")
    endif()
endforeach()
string(REGEX MATCHALL "Destroyed [^\r\n]+|Terminated GLFW" baseCleanup "${standardOutput}")
set(expectedCleanup "Destroyed device;Destroyed surface;Destroyed debug messenger;Destroyed instance;Destroyed window;Terminated GLFW")
if(testCase STREQUAL "invalid-color" OR testCase STREQUAL "nonfinite-color")
    set(expectedCleanup "Destroyed window;Terminated GLFW")
endif()
if(NOT "${baseCleanup}" STREQUAL "${expectedCleanup}")
    message(FATAL_ERROR "Base cleanup mismatch: ${baseCleanup}")
endif()
string(FIND "${standardOutput}" "Destroyed device" deviceDestroyPosition)
string(REGEX MATCHALL "Released [^\r\n]+" releaseLines "${standardOutput}")
foreach(releaseLine IN LISTS releaseLines)
    string(FIND "${standardOutput}" "${releaseLine}" releasePosition REVERSE)
    if(deviceDestroyPosition LESS releasePosition)
        message(FATAL_ERROR "Child outlives device: ${releaseLine}")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/checkVulkanDiagnostics.cmake")
message(STATUS "PASS presentation ${testCase}: exit=${exitCode}; matched create/release counts; no unexpected validation")
