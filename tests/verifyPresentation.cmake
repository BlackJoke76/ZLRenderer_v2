cmake_minimum_required(VERSION 3.24)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "ZL_VULKAN_TEST_CASE=${testCase}"
    "VK_LAYER_VALIDATE_SYNC=1" "${testExecutable}"
    RESULT_VARIABLE exitCode OUTPUT_VARIABLE standardOutput ERROR_VARIABLE standardError TIMEOUT 20)
file(MAKE_DIRECTORY "${logDirectory}")
file(WRITE "${logDirectory}/${testCase}.stdout.log" "${standardOutput}")
file(WRITE "${logDirectory}/${testCase}.stderr.log" "${standardError}")
set(successCases triangle triangle-rebuild normal fifo alternate fence-timeout acquire-timeout acquire-out-of-date acquire-suboptimal present-out-of-date present-suboptimal old-chain prepare-resize prepare-zero prepare-iconified initial-zero initial-iconified
    surface-zero surface-variable-zero surface-width-zero)
if(testCase STREQUAL "prepare-close" OR testCase STREQUAL "initial-zero-close")
    if(NOT exitCode STREQUAL "0" OR NOT standardOutput MATCHES "Controlled close before creation")
        message(FATAL_ERROR "Controlled close failed: ${exitCode}")
    endif()
    if(testCase STREQUAL "prepare-close" AND NOT standardOutput MATCHES "Frame summary: submitted=3 presented=3 generations=1")
        message(FATAL_ERROR "Close during preparation created/submitted another generation")
    endif()
    if(testCase STREQUAL "initial-zero-close" AND NOT standardOutput MATCHES "Frame summary: submitted=0 presented=0 generations=0")
        message(FATAL_ERROR "Initially paused close created work")
    endif()
elseif(testCase IN_LIST successCases)
    if(NOT exitCode STREQUAL "0" OR NOT standardOutput MATCHES "Frame summary: submitted=12 presented=[0-9]+")
        message(FATAL_ERROR "Frame progress failed: exit=${exitCode}\n${standardOutput}\n${standardError}")
    endif()
    if(NOT standardOutput MATCHES "Frame submitted slot=0" OR NOT standardOutput MATCHES "Frame submitted slot=1")
        message(FATAL_ERROR "Both frame slots must execute")
    endif()
    if(testCase MATCHES "out-of-date|suboptimal" AND NOT standardOutput MATCHES "Swapchain generation=2")
        message(FATAL_ERROR "Expected reconstruction did not occur")
    endif()
    if(testCase STREQUAL "fifo" AND NOT standardOutput MATCHES "mode=FIFO")
        message(FATAL_ERROR "FIFO runtime did not use FIFO")
    endif()
    if(testCase STREQUAL "alternate" AND NOT standardOutput MATCHES "clearColor=\\(0.200,0.050,0.100,1.000\\)")
        message(FATAL_ERROR "Alternate color not applied")
    endif()
    if(testCase MATCHES "timeout" AND NOT standardOutput MATCHES "Frame skipped:")
        message(FATAL_ERROR "Timeout control path not reached")
    endif()
    string(REGEX MATCHALL "Frame submitted slot=[^\r\n]+" frameRecords "${standardOutput}")
    foreach(frameRecord IN LISTS frameRecords)
        if(NOT frameRecord MATCHES "slot=([0-9]+) image=([0-9]+) command=([0-9A-Fa-f]+) acquire=([0-9A-Fa-f]+) present=([0-9A-Fa-f]+) fence=([0-9A-Fa-f]+) generation=([0-9]+)")
            message(FATAL_ERROR "Cannot parse resource identity: ${frameRecord}")
        endif()
        set(slotKey "slot_${CMAKE_MATCH_1}")
        set(imageKey "image_${CMAKE_MATCH_7}_${CMAKE_MATCH_2}")
        set(slotIdentity "${CMAKE_MATCH_3};${CMAKE_MATCH_4};${CMAKE_MATCH_6}")
        set(presentIdentity "${CMAKE_MATCH_5}")
        if(DEFINED ${slotKey} AND NOT "${${slotKey}}" STREQUAL "${slotIdentity}")
            message(FATAL_ERROR "Frame slot allocated new command/sync objects")
        endif()
        if(DEFINED ${imageKey} AND NOT "${${imageKey}}" STREQUAL "${presentIdentity}")
            message(FATAL_ERROR "Present semaphore must follow image identity")
        endif()
        set(${slotKey} "${slotIdentity}")
        set(${imageKey} "${presentIdentity}")
    endforeach()
else()
    if(NOT exitCode STREQUAL "1" OR NOT standardError MATCHES "Renderer failed:")
        message(FATAL_ERROR "Expected error exit: exit=${exitCode}\n${standardOutput}\n${standardError}")
    endif()
    if(testCase MATCHES "^(record|submit)$" AND NOT standardOutput MATCHES "Frame summary: submitted=0 presented=0")
        message(FATAL_ERROR "An aborted frame was counted as submitted")
    endif()
    if(testCase STREQUAL "submit" AND NOT standardError MATCHES "submit: vkQueueSubmit failed")
        message(FATAL_ERROR "Actual submit failure control path missing")
    endif()
    if(testCase STREQUAL "wait-failure" AND NOT standardError MATCHES "shutdown: vkDeviceWaitIdle failed")
        message(FATAL_ERROR "Wait failure was reported as normal close")
    endif()
endif()
# Every owned handle emits exactly one creation/release. Raw images and queues have no destruction.
foreach(resource "command pool" "acquire semaphore" "submission fence" "swapchain" "render pass" "image view" "framebuffer" "present semaphore" "shader module" "pipeline layout" "graphics pipeline")
    string(REGEX MATCHALL "Created ${resource}[\r\n]" creationEvents "${standardOutput}")
    string(REGEX MATCHALL "Released ${resource}[\r\n]" releaseEvents "${standardOutput}")
    list(LENGTH creationEvents creationCount)
    list(LENGTH releaseEvents releaseCount)
    if(NOT creationCount EQUAL releaseCount)
        message(FATAL_ERROR "Lifetime mismatch ${resource}: created=${creationCount} released=${releaseCount}")
    endif()
endforeach()
string(REGEX MATCHALL "Destroyed [^\r\n]+|Terminated GLFW" baseCleanup "${standardOutput}")
set(expectedCleanup "Destroyed device;Destroyed surface;Destroyed debug messenger;Destroyed instance;Destroyed window;Terminated GLFW")
if(testCase STREQUAL "invalid-color" OR testCase STREQUAL "nonfinite-color")
    set(expectedCleanup "Destroyed window;Terminated GLFW")
endif()
if(NOT "${baseCleanup}" STREQUAL "${expectedCleanup}")
    message(FATAL_ERROR "Base cleanup mismatch: ${baseCleanup}")
endif()
string(FIND "${standardOutput}" "Destroyed device" deviceDestroyPosition)
string(REGEX MATCHALL "Released [^\r\n]+" releaseLines "${standardOutput}")
foreach(releaseLine IN LISTS releaseLines)
    string(FIND "${standardOutput}" "${releaseLine}" releasePosition REVERSE)
    if(deviceDestroyPosition LESS releasePosition)
        message(FATAL_ERROR "Child outlives device: ${releaseLine}")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/checkVulkanDiagnostics.cmake")
message(STATUS "PASS presentation ${testCase}: exit=${exitCode}; matched create/release counts; no unexpected validation")

# A created generation owns exactly the objects logged for it. Addresses may be reused after release.
string(REGEX MATCHALL "Generation resource action=[^\r\n]+" resourceRecords "${standardOutput}")
set(liveObjects)
foreach(resourceRecord IN LISTS resourceRecords)
    if(NOT resourceRecord MATCHES "action=(Created|Released) generation=([0-9]+) type=(.+) handle=([0-9A-Fa-f]+)")
        message(FATAL_ERROR "Cannot parse generation object: ${resourceRecord}")
    endif()
    set(objectKey "${CMAKE_MATCH_2}:${CMAKE_MATCH_3}:${CMAKE_MATCH_4}")
    if(CMAKE_MATCH_1 STREQUAL "Created")
        if(objectKey IN_LIST liveObjects)
            message(FATAL_ERROR "Duplicate object ownership: ${objectKey}")
        endif()
        list(APPEND liveObjects "${objectKey}")
    else()
        if(NOT objectKey IN_LIST liveObjects)
            message(FATAL_ERROR "Object released without ownership: ${objectKey}")
        endif()
        list(REMOVE_ITEM liveObjects "${objectKey}")
    endif()
endforeach()
if(liveObjects)
    message(FATAL_ERROR "Generation objects leaked: ${liveObjects}")
endif()
string(REGEX MATCHALL "Generation resource action=[^\r\n]+|Swapchain published [^\r\n]+|Frame attachments [^\r\n]+" ownershipRecords "${standardOutput}")
set(liveAttachments)
set(publishedGeneration 0)
foreach(ownershipRecord IN LISTS ownershipRecords)
    if(ownershipRecord MATCHES "action=(Created|Released) generation=([0-9]+) type=(.+) handle=([0-9A-Fa-f]+)")
        set(attachmentKey "${CMAKE_MATCH_2}:${CMAKE_MATCH_3}:${CMAKE_MATCH_4}")
        if(CMAKE_MATCH_1 STREQUAL "Created")
            list(APPEND liveAttachments "${attachmentKey}")
        else()
            list(REMOVE_ITEM liveAttachments "${attachmentKey}")
        endif()
    elseif(ownershipRecord MATCHES "Swapchain published generation=([0-9]+)")
        set(publishedGeneration "${CMAKE_MATCH_1}")
    elseif(ownershipRecord MATCHES "Frame attachments generation=([0-9]+) framebuffer=([0-9A-Fa-f]+) renderPass=([0-9A-Fa-f]+)")
        set(framebufferKey "${CMAKE_MATCH_1}:framebuffer:${CMAKE_MATCH_2}")
        set(renderPassKey "${CMAKE_MATCH_1}:render pass:${CMAKE_MATCH_3}")
        if(NOT CMAKE_MATCH_1 STREQUAL publishedGeneration OR NOT framebufferKey IN_LIST liveAttachments OR NOT renderPassKey IN_LIST liveAttachments)
            message(FATAL_ERROR "Frame referenced unowned, retired or unpublished attachments: ${ownershipRecord}")
        endif()
    endif()
endforeach()
if(testCase STREQUAL "old-chain")
    string(REGEX MATCHALL "Swapchain (create |created |published )[^\r\n]+|Generation resource action=Released generation=[^\r\n]+type=swapchain[^\r\n]+|Frame submitted [^\r\n]+" chainRecords "${standardOutput}")
    set(activeGeneration 0)
    set(previousHandle "0000000000000000")
    foreach(chainRecord IN LISTS chainRecords)
        if(chainRecord MATCHES "Swapchain create generation=([0-9]+) old=([0-9A-Fa-f]+)")
            set(candidateGeneration "${CMAKE_MATCH_1}")
            if(NOT CMAKE_MATCH_2 STREQUAL previousHandle)
                message(FATAL_ERROR "Replacement did not use the live predecessor: ${chainRecord}")
            endif()
        elseif(chainRecord MATCHES "Swapchain created generation=([0-9]+) handle=([0-9A-Fa-f]+) old=")
            set(candidateHandle "${CMAKE_MATCH_2}")
        elseif(chainRecord MATCHES "Swapchain published generation=([0-9]+) handle=([0-9A-Fa-f]+)")
            if(NOT CMAKE_MATCH_1 STREQUAL candidateGeneration OR NOT CMAKE_MATCH_2 STREQUAL candidateHandle)
                message(FATAL_ERROR "Published incomplete candidate")
            endif()
            set(activeGeneration "${CMAKE_MATCH_1}")
            set(previousHandle "${CMAKE_MATCH_2}")
        elseif(chainRecord MATCHES "Frame submitted .*generation=([0-9]+)")
            if(NOT CMAKE_MATCH_1 STREQUAL activeGeneration)
                message(FATAL_ERROR "Frame used unpublished/retired generation")
            endif()
        elseif(chainRecord MATCHES "Released generation=([0-9]+) type=swapchain")
            if(CMAKE_MATCH_1 LESS 3 AND NOT activeGeneration GREATER CMAKE_MATCH_1)
                message(FATAL_ERROR "Predecessor destroyed before replacement publication")
            endif()
        endif()
    endforeach()
    if(NOT activeGeneration EQUAL 3)
        message(FATAL_ERROR "Two replacements were not completed")
    endif()
endif()

if(testCase STREQUAL "prepare-resize" AND NOT standardOutput MATCHES "Swapchain ready generation=2 framebuffer=640x480 extent=640x480 submitted=3")
    message(FATAL_ERROR "Post-wait resize did not replace the old snapshot")
endif()
if(testCase MATCHES "^(prepare-zero|prepare-iconified|surface-zero|surface-variable-zero|surface-width-zero)$")
    if(NOT standardOutput MATCHES "Presentation paused: .*generation=1 submitted=3 presented=3 rebuildRequested=1" OR
       NOT standardOutput MATCHES "Presentation resumed: .*generation=2 submitted=3 presented=3 rebuildRequested=0")
        message(FATAL_ERROR "Deferred reconstruction lost frame state or its request")
    endif()
    if(NOT standardOutput MATCHES "Frame summary: submitted=12 presented=12 generations=2")
        message(FATAL_ERROR "Deferred path did not converge")
    endif()
endif()
if(testCase STREQUAL "initial-zero" OR testCase STREQUAL "initial-iconified")
    if(NOT standardOutput MATCHES "Presentation paused: .*generation=0 submitted=0" OR
       NOT standardOutput MATCHES "Swapchain ready generation=1")
        message(FATAL_ERROR "Initial deferred creation not covered")
    endif()
endif()

if(testCase MATCHES "module|pipeline")
    if(NOT standardError MATCHES "${testCase}: injected failure")
        message(FATAL_ERROR "Expected drawing checkpoint missing: ${standardError}")
    endif()
endif()
if(testCase STREQUAL "triangle-rebuild" AND NOT standardOutput MATCHES "Frame summary: submitted=12 presented=12 generations=2")
    message(FATAL_ERROR "Triangle replacement did not complete")
endif()

# Check each drawing pipeline is live in the currently published generation.
string(REGEX MATCHALL "Generation resource action=[^\r\n]+|Swapchain published [^\r\n]+|Triangle draw [^\r\n]+" drawingRecords "${standardOutput}")
set(livePipelines)
set(drawingGeneration 0)
foreach(drawingRecord IN LISTS drawingRecords)
    if(drawingRecord MATCHES "action=(Created|Released) generation=([0-9]+) type=graphics pipeline handle=([0-9A-Fa-f]+)")
        set(pipelineKey "${CMAKE_MATCH_2}:${CMAKE_MATCH_3}")
        if(CMAKE_MATCH_1 STREQUAL "Created")
            list(APPEND livePipelines "${pipelineKey}")
        else()
            list(REMOVE_ITEM livePipelines "${pipelineKey}")
        endif()
    elseif(drawingRecord MATCHES "Swapchain published generation=([0-9]+)")
        set(drawingGeneration "${CMAKE_MATCH_1}")
    elseif(drawingRecord MATCHES "Triangle draw generation=([0-9]+) pipeline=([0-9A-Fa-f]+)")
        set(pipelineKey "${CMAKE_MATCH_1}:${CMAKE_MATCH_2}")
        if(NOT CMAKE_MATCH_1 STREQUAL drawingGeneration OR NOT pipelineKey IN_LIST livePipelines)
            message(FATAL_ERROR "Draw uses unowned or retired pipeline: ${drawingRecord}")
        endif()
    endif()
endforeach()
