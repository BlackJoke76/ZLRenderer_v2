cmake_minimum_required(VERSION 3.24)
# Run the same entry point and context as production, compiled with isolated test hooks.
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "ZL_VULKAN_TEST_CASE=${testCase}" "${testExecutable}"
    RESULT_VARIABLE exitCode OUTPUT_VARIABLE standardOutput ERROR_VARIABLE standardError TIMEOUT 20)
file(MAKE_DIRECTORY "${logDirectory}")
file(WRITE "${logDirectory}/${testCase}.stdout.log" "${standardOutput}")
file(WRITE "${logDirectory}/${testCase}.stderr.log" "${standardError}")

set(expectedCleanup "Destroyed window;Terminated GLFW")
set(expectedReason "")
if(testCase STREQUAL "missing-layer")
    set(expectedReason "missing layer VK_LAYER_KHRONOS_validation")
elseif(testCase STREQUAL "missing-extension")
    set(expectedReason "missing extension VK_EXT_debug_utils")
elseif(testCase STREQUAL "instance")
    set(expectedReason "instance: injected failure")
    list(PREPEND expectedCleanup "Destroyed instance")
elseif(testCase STREQUAL "messenger")
    set(expectedReason "messenger: injected failure")
    list(PREPEND expectedCleanup "Destroyed debug messenger" "Destroyed instance")
else()
    list(PREPEND expectedCleanup "Destroyed surface" "Destroyed debug messenger" "Destroyed instance")
    if(testCase STREQUAL "surface")
        set(expectedReason "surface: injected failure")
    elseif(testCase STREQUAL "no-device")
        set(expectedReason "physical device selection: no suitable")
    elseif(testCase STREQUAL "create-device")
        set(expectedReason "logical device: vkCreateDevice failed [(]VkResult=-3[)]")
    elseif(testCase STREQUAL "device")
        set(expectedReason "device: injected failure")
        list(PREPEND expectedCleanup "Destroyed device")
    elseif(testCase STREQUAL "diagnostic")
        list(PREPEND expectedCleanup "Destroyed device")
    else()
        message(FATAL_ERROR "Unknown lifecycle test: ${testCase}")
    endif()
endif()

if(testCase STREQUAL "diagnostic")
    if(NOT exitCode EQUAL 0 OR NOT standardOutput MATCHES "Vulkan initialization succeeded" OR
       NOT standardError MATCHES "\\[Vulkan WARNING\\] \\[ZLRenderer-ControlledDiagnostic\\] Controlled callback delivery test")
        message(FATAL_ERROR "Diagnostic delivery/lifecycle failed: exit=${exitCode}\n${standardOutput}\n${standardError}")
    endif()
else()
    if(NOT exitCode STREQUAL "1" OR NOT standardError MATCHES "Initialization failed: .*${expectedReason}" OR
       standardOutput MATCHES "Vulkan initialization succeeded")
        message(FATAL_ERROR "Failure contract failed: exit=${exitCode}\n${standardOutput}\n${standardError}")
    endif()
endif()

string(REGEX MATCHALL "Destroyed [^\r\n]+|Terminated GLFW" actualCleanup "${standardOutput}")
if(NOT "${actualCleanup}" STREQUAL "${expectedCleanup}")
    message(FATAL_ERROR "Cleanup order/count mismatch: expected=${expectedCleanup}; actual=${actualCleanup}")
endif()
# Classify each line separately, so a known loader line cannot consume an unrelated diagnostic.
# Preserve raw logs; only the two concrete pre-existing issues recorded in STATUS are allowed.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/knownEnvironmentDiagnostics.txt" knownEnvironmentPatterns)
string(REPLACE "\r" "" diagnosticLines "${standardError}")
string(REPLACE ";" "\\;" diagnosticLines "${diagnosticLines}")
string(REPLACE "\n" ";" diagnosticLines "${diagnosticLines}")
foreach(diagnosticLine IN LISTS diagnosticLines)
    if(NOT diagnosticLine MATCHES "\\[Vulkan (WARNING|ERROR)\\]")
        continue()
    endif()
    if(testCase STREQUAL "diagnostic" AND diagnosticLine STREQUAL
       "[Vulkan WARNING] [ZLRenderer-ControlledDiagnostic] Controlled callback delivery test; no invalid Vulkan operation.")
        continue()
    endif()
    set(knownEnvironmentMessage FALSE)
    foreach(environmentPattern IN LISTS knownEnvironmentPatterns)
        if(diagnosticLine MATCHES "^${environmentPattern}$")
            set(knownEnvironmentMessage TRUE)
            message(STATUS "Known environment diagnostic preserved: ${diagnosticLine}")
            break()
        endif()
    endforeach()
    if(NOT knownEnvironmentMessage)
        message(FATAL_ERROR "Unexpected Vulkan diagnostic: ${diagnosticLine}")
    endif()
endforeach()
message(STATUS "PASS ${testCase}: exit=${exitCode}; cleanup=${actualCleanup}")
